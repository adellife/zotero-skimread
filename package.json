{
  "name": "zotero-skimread",
  "type": "module",
  "version": "0.2.4",
  "description": "Semantic Reader-style global skimming highlights for Zotero, private by default with optional structured cloud providers",
  "config": {
    "addonName": "SkimRead",
    "addonID": "skimread@adellife.github.io",
    "addonRef": "skimread",
    "addonInstance": "SkimRead",
    "prefsPrefix": "extensions.zotero.skimread"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adellife/zotero-skimread.git"
  },
  "author": "Adel Tayebi",
  "bugs": {
    "url": "https://github.com/adellife/zotero-skimread/issues"
  },
  "homepage": "https://github.com/adellife/zotero-skimread#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
